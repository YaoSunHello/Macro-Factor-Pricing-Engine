)

# ── 2. Yields ────────────────────────────────────────────────────────────────
yields = bq.execute(
    bq.univ.list(['GT2 Govt', 'GT5 Govt', 'GT10 Govt', 'GT30 Govt']),
    bq.data.px_last(
        dates=bq.func.range('1953-01-01', '0D'),
        fill='prev'
    )
)

# ── 3. TIPS Real Yields & Breakevens (post-1997) ─────────────────────────────
